# go_starter — contoh konfigurasi. Salin ke .env dan sesuaikan.
PORT=8080
# DATABASE_URL = role OWNER: dipakai migrasi + boot (BYPASS RLS, butuh privilege
# ALTER/CREATE POLICY). Multi-tenancy: RLS Postgres mengisolasi data antar-tenant.
DATABASE_URL=postgres://user@localhost:5432/go_starter?sslmode=disable
# APP_DATABASE_URL = pool RUNTIME app. Bedanya dengan DATABASE_URL bukan
# DATABASE-nya (sama persis) melainkan ROLE-nya: DATABASE_URL memakai owner yang
# butuh ALTER/CREATE POLICY untuk migrasi, sementara runtime harus memakai role
# TERBATAS agar RLS mengikat. Satu role tak bisa keduanya — owner & superuser
# SELALU bypass RLS.
#
# Yang dibelinya: query yang lupa WHERE tenant_id mengembalikan 0 baris, bukan
# data pelanggan lain. (Terukur: sebagai owner query yang sama membaca 82 baris
# dari 15 tenant; sebagai app_rw hanya 13 baris dari 1 tenant.)
#
# TAK PERLU diisi benar "menurut ingatan" — aplikasi MEMBUKTIKANNYA sendiri saat
# boot dengan bertanya ke Postgres apakah koneksi ini sungguh terikat RLS:
#   production + multi-tenant → menolak start bila tidak, dengan SQL siap tempel
#   dev / single-app          → hanya peringatan (tak ada yang bisa bocor)
# Jadi mengisinya SAMA dengan DATABASE_URL pun akan ketahuan, bukan lolos senyap.
#
# Kalau memakai PgBouncer: yang lewat pooler adalah env INI (runtime), sedangkan
# DATABASE_URL harus koneksi LANGSUNG — migrasi memakai pg_advisory_lock yang
# butuh session tetap, dan transaction pooling melepasnya tiap transaksi.
APP_DATABASE_URL=
TEST_DATABASE_URL=postgres://user@localhost:5432/go_starter_test?sslmode=disable
REDIS_ADDR=localhost:6379
ENV=dev
# AUTO_MIGRATE: dev=true (migrate otomatis saat boot). PRODUKSI=false — migrasi
# dijalankan container `migrate` terpisah (lihat docker-compose.yml) SEBELUM app
# start, agar lifecycle migrasi terpisah dari deploy app (aman rollback).
AUTO_MIGRATE=true
# SESSION_KEY — wajib di production, kosongkan di dev.
# Minimal 32 karakter: app PANIC saat boot bila kosong ATAU terlalu pendek.
# "SESSION_KEY=rahasia" akan DITOLAK — kunci lemah = kunci yang tak ada, dan
# lebih berbahaya karena menciptakan rasa aman yang keliru.
# Buat dengan:  openssl rand -base64 48
SESSION_KEY=

# Google OAuth. Opsional di dev (tombol Google nonaktif bila kosong),
# WAJIB di production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# APP_BASE_URL = alamat PUBLIK aplikasi — TANPA path, tanpa trailing slash.
#
# Path callback SENGAJA tidak ada di sini: ia dirakit dari route aplikasi
# (handler.PathGoogleCallback), sehingga redirect_uri mustahil berbeda dari route
# yang melayaninya. Menyimpan path yang sama di dua tempat berarti salah ketik di
# salah satunya muncul sebagai `redirect_uri_mismatch` — pesan yang tak menyebut
# sebabnya. Yang didaftarkan di Google Cloud Console adalah hasil rakitannya:
#
#     <APP_BASE_URL>/api/auth/callback/google
#
# Di production WAJIB https:// (app menolak start bila bukan — cookie sesi Secure
# tak terkirim lewat http). Nilai ini juga jadi dasar tautan undangan; bila
# kosong di dev, host ditebak dari request.
APP_BASE_URL=http://localhost:8080

# Model role 2-BIDANG (multi-tenancy):
#   PLATFORM: super_admin (env ini, immutable, nol baris DB) + staff (tabel
#             platform_staff, mutable) — operator lintas-tenant, bypass RLS.
#   TENANT:   owner > admin > member — anggota satu tenant, scoped RLS.
# super_admin "sejati" (root immutable) — email dipisah koma. Email di sini selalu
# super_admin (di-overlay per-request, TAK ditulis ke users.role) & tak bisa
# diturunkan/diblokir/dihapus lewat panel. 1 user = 1 tenant (register = tenant baru).
SUPER_ADMIN_EMAILS=

# Zona waktu (IANA) untuk agregasi tampilan panel aktivitas ("jam berapa user
# aktif"). Data disimpan UTC; ini hanya untuk konversi saat baca. Default WIB.
APP_TIMEZONE=Asia/Jakarta

# Kuota workspace yang boleh DIMILIKI (role owner) tiap user — dipakai saat user
# dibuat; tersimpan per-user di users.workspace_quota agar platform bisa override
# tanpa ubah env (lever monetisasi: free/pro/enterprise). Diundang jadi
# member/admin TIDAK memakan kuota.
MAX_WORKSPACES_PER_USER=3

# APP_MODE — BENTUK APLIKASI. Keputusan PERTAMA saat meng-clone template ini,
# karena ia menentukan seluruh bentuk URL (lihat docs/decisions/0006).
#
#   multi  (default) → multi-tenant. Tiap user bisa punya banyak workspace,
#                      alamatnya /w/{slug}/...
#   single           → SATU aplikasi. Tak ada konsep workspace di mata pemakai,
#                      semuanya di /app/... Pendaftar bergabung sebagai `member`;
#                      pengelola ditentukan SUPER_ADMIN_EMAILS di bawah.
#
# Mengubahnya SETELAH ada data berisiko: single + >1 workspace = app menolak
# start (memilih diam-diam berarti workspace lain lenyap dari pandangan).
# Arah sebaliknya (single → multi) aman.
APP_MODE=multi

# APP_NAME — nama aplikasi di mode single; dipakai membuat workspace tunggal saat
# boot pertama. Slug-nya KONSTAN "app" (bukan dari nama ini) agar path selalu
# /app di semua deployment. Diabaikan di mode multi.
APP_NAME=App

# ═══════════════════════════════════════════════════════════════════════════
# PRODUKSI (Docker + Portainer) — lihat docker-compose.yml & README §Deploy
# ═══════════════════════════════════════════════════════════════════════════
# ENV=production. Var WAJIB (app PANIC saat boot bila kosong/tak sah):
#   DATABASE_URL, REDIS_ADDR, SESSION_KEY (>=32 char),
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, APP_BASE_URL (https://)
# Prinsip: yang berbahaya bila salah GAGAL KERAS saat boot — bukan warning di log
# yang mudah terlewat, dan bukan default diam-diam yang tampak berjalan normal.
# ENV=production juga otomatis menyalakan Secure pada cookie sesi (HTTPS-only) —
# tak ada env terpisah untuk itu, supaya tak ada yang bisa lupa diisi.
#
# APP_DATABASE_URL tak masuk daftar "wajib" di atas KARENA ia diperiksa dengan
# cara yang lebih kuat: aplikasi membuktikan sendiri ke Postgres apakah RLS
# sungguh mengikat (lihat penjelasannya di atas). Env terisi ≠ env benar.
#
# PGBOUNCER (bila dipakai): set MAX_PREPARED_STATEMENTS di pooler — nilainya
# ANGKA (ukuran LRU cache per koneksi), bukan true/false. pgx v5 mem-prepare
# secara default; di transaction pooling tanpa dukungan ini, prepare mendarat di
# satu backend dan execute di backend lain → "prepared statement does not exist",
# yang muncul HANYA di bawah beban dan tak pernah saat testing.
#   MAX_PREPARED_STATEMENTS: 200
# WAJIB: AUTO_MIGRATE=false (app tak migrate; container `migrate` yang kerjakan).
# Service `migrate` HANYA butuh DATABASE_URL.
# APP_BASE_URL harus domain publik, mis: https://app.contoh.com
# (yang didaftarkan di Google Console: https://app.contoh.com/api/auth/callback/google)
