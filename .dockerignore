/tailwindcss
/app
/tmp

# Rahasia & env lokal
.env
.env.*

# Artefak lokal / IDE
.DS_Store
.idea
.vscode
*.test
*.out
*-check
NOTE.md

# Dokumentasi (tak dibutuhkan saat build)
*.md
